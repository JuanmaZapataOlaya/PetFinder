# Portkey: usado por /search para generar el embedding de la consulta.
PORTKEY_API_KEY=replace-with-your-portkey-api-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Supabase: usa una service-role key solo en este proceso de administración.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Debe coincidir con TURBOVEC_SYNC_TOKEN configurado en Supabase.
TURBOVEC_SYNC_TOKEN=replace-with-a-long-random-token
TURBOVEC_URL=https://tu-dominio-del-tunnel.example.com

# Persistencia local del indice TurboVec.
TURBOVEC_INDEX_PATH=data/pet_tickets.tvim
VECTOR_DIMENSION=1536
TURBOVEC_BIT_WIDTH=4

# Origenes permitidos para llamadas del navegador, separados por comas.
# Ejemplo: http://localhost:5173,https://tu-frontend.example.com
TURBOVEC_ALLOWED_ORIGINS=http://localhost:5173

# Reindexación: lotes pequeños son más estables a través de Cloudflare Tunnel.
REINDEX_BATCH_SIZE=25
